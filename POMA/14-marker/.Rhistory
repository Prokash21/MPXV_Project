setwd("E:/DWCT/DEG/GSE219036_6_june/POMA/14-marker")
#Load necessary libraries
library(pROC)
library(randomForest)
# Read the dataset
X <- read.csv("14_clade_IIb_pROC.csv")
# <- rbind(X, X)
# Define the outcome variable
obese <- X$condition
# Select the 14 genes
genes <- X[, c("ENSG00000141646", "ENSG00000175029", "ENSG00000198431", "ENSG00000142798",
"ENSG00000145386", "ENSG00000134057", "ENSG00000157456", "ENSG00000156970",
"ENSG00000169679", "ENSG00000087586", "ENSG00000138160", "ENSG00000117399",
"ENSG00000171848", "ENSG00000175063")]
# Convert genes to data frame
genes <- as.data.frame(genes)
# Initialize a list to store ROC info for each gene
roc_list <- list()
# Loop through each gene to fit logistic regression and random forest models
for (gene in colnames(genes)) {
# Fit logistic regression model for the current gene
glm.fit <- glm(obese ~ genes[, gene], family = binomial)
glm.probs <- predict(glm.fit, type = "response")
# Fit random forest model for the current gene
rf.model <- randomForest(factor(obese) ~ genes[, gene])
rf.probs <- rf.model$votes[, 2]  # Probability for the positive class
# Calculate ROC info for logistic regression
glm_roc <- roc(obese, glm.probs)
# Calculate ROC info for random forest
rf_roc <- roc(obese, rf.probs)
# Store ROC info for the current gene
roc_list[[gene]] <- list(glm = glm_roc, rf = rf_roc)
}
# Plot individual ROC curves and AUC for each gene
par(mfrow = c(4, 4))  # Arrange plots in a 4x4 grid
for (gene in colnames(genes)) {
plot(roc_list[[gene]]$glm, col = "#377eb8", main = paste("Gene:", gene), legacy.axes = TRUE, percent = TRUE)
plot.roc(roc_list[[gene]]$rf, col = "#4daf4a", add = TRUE, percent = TRUE)
legend("bottomright", legend = c("Logistic Regression", "Random Forest"), col = c("#377eb8", "#4daf4a"), lwd = 2)
}
# Reset par() variables
par(pty = "m")
# Plot the Random Forest model
plot(rf.model)
varImpPlot(rf.model)
