# Load your gene list
my_gene_list <- c("WDR37", "NFAT5", "ICAM5", "ICAM5",
"ICAM5", "ELL", "PLAGL1", "DHX38", "GATA6", "ZNF212", "CBX6")  # Replace with your gene symbols
