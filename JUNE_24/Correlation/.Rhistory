library(caret)
library(e1071)
library(randomForest)
library(limma)
library(dplyr)
# Generate Sample Data
set.seed(123)
n_genes <- 100
n_samples <- 200
gene_data <- as.data.frame(matrix(rnorm(n_genes * n_samples), nrow = n_samples, ncol = n_genes))
colnames(gene_data) <- paste0("Gene", 1:n_genes)
response <- factor(sample(c("Condition1", "Condition2"), n_samples, replace = TRUE))
data <- cbind(gene_data, Response = response)
# Identify DE Genes
design <- model.matrix(~ response)
fit <- lmFit(gene_data, design)
fit <- eBayes(fit)
topTable <- topTable(fit, adjust = "BH", number = n_genes)
# Filter DE Genes
lfc_threshold <- 1
pval_threshold <- 0.05
de_genes <- topTable %>%
filter(abs(logFC) > lfc_threshold & adj.P.Val < pval_threshold) %>%
rownames_to_column("Gene")
