# Display summary of DESeq2 results
summary(res)
# Set seed for reproducibility
set.seed(123)
# Simulate gene expression counts (1000 genes, 20 samples)
# 100 of these genes will have a true difference between control and treated
n_genes <- 1000
n_samples <- 20
n_control <- 10
n_treated <- 10
# Baseline expression for control group (negative binomial distribution)
baseline <- matrix(rnbinom(n_genes * n_control, mu = 10, size = 1/0.2), ncol = n_control)
# For the treated group, add a fold change to some of the genes (introducing DE genes)
treated <- baseline
treated[1:100, ] <- treated[1:100, ] * 4  # Introducing a 4-fold change for the first 100 genes
# Combine into a single count matrix
counts <- cbind(baseline, treated)
# Create condition labels (control and treated)
condition <- factor(c(rep("control", n_control), rep("treated", n_treated)))
# Create colData for DESeq2
col_data <- data.frame(row.names = colnames(counts), condition = condition)
# Print dimensions and check
dim(counts)
head(counts[, 1:5])  # Checking a few columns
# Print dimensions and check
dim(counts)
head(counts[, 1:5])  # Checking a few columns
# Create DESeq2 dataset
dds <- DESeqDataSetFromMatrix(countData = counts, colData = col_data, design = ~ condition)
# Run DESeq2
dds <- DESeq(dds)
# Get DESeq2 results
res <- results(dds)
# Display summary of DESeq2 results
summary(res)
# Subset DE genes with adjusted p-value < 0.05
DE_genes <- rownames(res[which(res$padj < 0.05),])
DE_genes <- DE_genes[!is.na(DE_genes)]  # Removing any NAs
# Check how many DE genes we have
length(DE_genes)
# Subset DE genes with adjusted p-value < 0.05
DE_genes <- rownames(res[which(res$padj ),])
# Subset DE genes with adjusted p-value < 0.05
DE_genes <- rownames(res[which(res$padj < 100),])
DE_genes <- DE_genes[!is.na(DE_genes)]  # Removing any NAs
# Check how many DE genes we have
length(DE_genes)
View(res)
res
# Subset DE genes with adjusted p-value < 0.05
DE_genes <- rownames(res[which(res$padj < 0.05),])
# Subset DE genes with adjusted p-value < 0.1
DE_genes <- rownames(res[which(res$padj < 0.1),])
length(DE_genes)  # Check the number of DE genes
View(counts)
View(counts)
library(mlr3)
library(mlr3learners)   # For additional machine learning models
library(mlr3filters)    # For feature selection
library(mlr3tuning)     # For hyperparameter tuning
library(mlr3benchmark)  # For benchmarking models
library(ggplot2)        # For visualization
library(dplyr)          # For data manipulation
# Load or simulate sample gene expression data
set.seed(123)
n_samples <- 100
n_genes <- 1000
# Simulate gene expression values (independent variables)
gene_expression <- matrix(rnorm(n_samples * n_genes), nrow = n_samples, ncol = n_genes)
colnames(gene_expression) <- paste0("Gene_", 1:n_genes)
View(gene_expression)
# Simulate binary classification (dependent variable, e.g., cancer type)
class <- factor(sample(c("Cancer", "Normal"), n_samples, replace = TRUE))
# Create a data frame for gene expression + class label
data <- as.data.frame(gene_expression)
data$class <- class
# Split data into train and test sets (70% train, 30% test)
set.seed(42)
train_indices <- sample(1:n_samples, size = 0.7 * n_samples)
train_data <- data[train_indices, ]
test_data <- data[-train_indices, ]
# Convert data to mlr3 Task for classification
task <- TaskClassif$new(id = "gene_expression_task", backend = train_data, target = "class")
# Normalize features (gene expression values)
task$select(setdiff(task$feature_names, "class"))  # Select only gene expression features
# --- Step 1: Feature Selection using Filter Method ---
# Use the Kruskal-Wallis test for selecting the top genes
filter <- flt("kruskal_test")
# Calculate filter scores for features in the task
filter$calculate(task)
# Inspect the structure of the filter$scores
str(filter$scores)
# If the scores are in a different column (e.g., column named "importance"), update the code:
filter_scores <- as.data.frame(filter$scores)
# Modify the code based on actual column names, for example:
# arrange by "importance" if "score" is not available
top_genes <- filter_scores %>% arrange(desc(importance)) %>% head(50)
View(filter_scores)
View(filter_scores)
# Convert filter scores (named vector) to a data frame
filter_scores <- as.data.frame(filter$scores)
filter_scores$gene <- rownames(filter_scores)  # Add gene names as a column
colnames(filter_scores) <- c("score", "gene")  # Rename columns for clarity
# Sort by score in descending order and select the top 50 genes
top_genes <- filter_scores %>% arrange(desc(score)) %>% head(50)
View(top_genes)
