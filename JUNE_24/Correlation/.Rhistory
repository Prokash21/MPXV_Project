library(caret)
library(e1071)
library(dplyr)
library(ROSE)
# Generate Sample Data
set.seed(123)
n_genes <- 100
n_samples <- 200
gene_data <- as.data.frame(matrix(rnorm(n_genes * n_samples), nrow = n_samples, ncol = n_genes))
colnames(gene_data) <- paste0("Gene", 1:n_genes)
response <- factor(sample(c("Condition1", "Condition2"), n_samples, replace = TRUE))
data <- cbind(gene_data, Response = response)
# Remove Constant Variables
non_constant_vars <- sapply(data[1:n_genes], function(x) length(unique(x)) > 1)
data <- data[, non_constant_vars]
# Scale the Data
features <- data %>% select(-Response)
response <- data$Response
features_scaled <- scale(features)
data_scaled <- cbind(features_scaled, Response = response)
# Generate Sample Data
set.seed(123)
n_genes <- 100
n_samples <- 200
gene_data <- as.data.frame(matrix(rnorm(n_genes * n_samples), nrow = n_samples, ncol = n_genes))
colnames(gene_data) <- paste0("Gene", 1:n_genes)
response <- factor(sample(c("Condition1", "Condition2"), n_samples, replace = TRUE))
data <- cbind(gene_data, Response = response)
View(data)
View(gene_data)
# Remove Constant Variables
non_constant_vars <- sapply(data[1:n_genes], function(x) length(unique(x)) > 1)
data <- data[, non_constant_vars]
View(data)
# Scale the Data
features <- data %>% select(-Response)
response <- data$Response
View(features)
features_scaled <- scale(features)
data_scaled <- cbind(features_scaled, Response = response)
# Feature Selection
control <- rfeControl(functions = rfFuncs, method = "cv", number = 10)
results <- rfe(features_scaled, response, sizes = c(5, 10, 15), rfeControl = control)
selected_features <- results$optVariables
# Nested Resampling
outer_control <- trainControl(method = "cv", number = 10, savePredictions = "final", classProbs = TRUE)
inner_control <- trainControl(method = "cv", number = 5, search = "grid")
grid <- expand.grid(mtry = c(2, 5, 10))
model <- train(
features_scaled[, selected_features], response,
method = "rf",
trControl = outer_control,
tuneGrid = grid
)
View(grid)
View(inner_control)
View(model)
View(outer_control)
# Benchmark Experiment
print(model)
predictions <- predict(model, features_scaled[, selected_features])
confusionMatrix(predictions, response)
